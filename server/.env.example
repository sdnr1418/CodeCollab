PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/codecollab?retryWrites=true&w=majority
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
# Signs CSRF tokens (Step 24). Another long random string, different from JWT_SECRET.
CSRF_SECRET=change-me-to-another-long-random-string
# Code runner, Leave as is to use the free public Judge0.
# If that stops working, use RapidAPI's Judge0: set the URL below and your key.
JUDGE0_URL=https://ce.judge0.com
# JUDGE0_URL=https://judge0-ce.p.rapidapi.com
# JUDGE0_KEY=your-rapidapi-key